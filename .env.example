# Copy this file to .env and fill in real values. .env is gitignored.
# Leave the values empty to boot the UI and API anyway: text analysis
# returns a clear "credentials are not configured" message, and OCR still runs.

# Endpoint of an Azure AI Language resource, without a path.
# Example: https://my-language.cognitiveservices.azure.com
AZURE_LANGUAGE_ENDPOINT=

# Key for that same resource (Keys and Endpoint blade in the Azure portal).
AZURE_LANGUAGE_KEY=

# Optional. The Streamlit service uses this to find the API.
# Docker Compose sets it to http://api:8000 for the ui container.
# A local `streamlit run` defaults to http://localhost:8000 when this is unset.
# API_BASE_URL=http://localhost:8000
